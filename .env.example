# Copy to .env.local for development. Set the same names in Vercel -> Settings -> Environment Variables.
# Never commit real values.

# Reply portal (/admin). Server-only - never prefix with NEXT_PUBLIC_.
ADMIN_PASSCODE="orderreply"

# SMTP (order / enquiry emails). Without these the site still works but sends no email.
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="465"
SMTP_USER="sales@independentelectricbikes.com.au"
SMTP_PASS=""
SMTP_FROM="noreply@independentelectricbikes.com.au"

# Optional destination overrides (fall back to FORMS.destinations in config/site.ts)
CONTACT_EMAIL=""
ORDER_EMAIL=""
WHOLESALE_EMAIL=""

# Upstash Redis (orders / enquiries storage). Without it the portal falls back to in-memory storage, which is lost on every serverless cold start.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
